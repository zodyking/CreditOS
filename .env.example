# ──────────────────────────────────────────────────────────────────────────────
# CreditOS environment
# Copy to .env for local development. On Dokploy, paste these into the
# service's Environment panel. Un-prefixed names and NUXT_-prefixed names are
# both accepted (e.g. DATABASE_URL or NUXT_DATABASE_URL).
# ──────────────────────────────────────────────────────────────────────────────

# ── Required ─────────────────────────────────────────────────────────────────
# External PostgreSQL 14+ connection string. CreditOS never runs its own DB.
DATABASE_URL=postgres://creditos:creditos@localhost:5432/creditos

# 32+ character secret used to encrypt/sign the session cookie.
# Generate: openssl rand -base64 48
NUXT_SESSION_PASSWORD=change-me-to-a-random-string-of-at-least-32-chars

# 32-byte key (base64 or hex) used for AES-256-GCM encryption of provider
# secrets stored in the database (OpenRouter key, mail provider keys).
# Generate: openssl rand -base64 32
APP_ENCRYPTION_KEY=change-me-base64-32-bytes

# ── Operating mode ───────────────────────────────────────────────────────────
# demo  → deterministic council simulator, sandbox mail, synthetic data allowed
# test  → live model calls allowed, external mail providers forced to sandbox
# live  → real providers where configured and consented
APP_MODE=demo

# Seed the synthetic demo dataset on first boot when the database is empty.
DEMO_SEED=true
# Run pending SQL migrations automatically on boot.
AUTO_MIGRATE=true

# ── AI (OpenRouter) ──────────────────────────────────────────────────────────
# Optional here: the key can also be entered (encrypted) in Settings → AI.
OPENROUTER_API_KEY=
OPENROUTER_DEFAULT_MODEL=openai/gpt-4o-mini
# Shown to OpenRouter as the referring app (optional).
OPENROUTER_SITE_URL=http://localhost:3000

# ── Storage ──────────────────────────────────────────────────────────────────
# Directory for uploaded documents and rendered PDFs. Mount as a volume.
DATA_DIR=./data

# ── Outbound mail providers (optional, P1) ───────────────────────────────────
# Provider: sandbox | docupost | postgrid
MAIL_OUTBOUND_PROVIDER=sandbox
DOCUPOST_API_KEY=
POSTGRID_API_KEY=
# Shared secret used to verify provider webhook signatures (HMAC-SHA256).
MAIL_WEBHOOK_SECRET=

# ── Inbound mailroom providers (optional, P1) ────────────────────────────────
# Provider: manual | postscan | earthclass
MAIL_INBOUND_PROVIDER=manual
POSTSCAN_API_KEY=
EARTHCLASS_API_KEY=

# ── Server ───────────────────────────────────────────────────────────────────
PORT=3000
HOST=0.0.0.0
NODE_ENV=production
