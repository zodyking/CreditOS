{
  "name": "creditos",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "description": "CreditOS — AI-powered personal credit intelligence and dispute operations platform (Nuxt 4, PostgreSQL, OpenRouter).",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.33.4",
  "scripts": {
    "dev": "nuxt dev",
    "build": "nuxt build",
    "preview": "nuxt preview",
    "start": "node .output/server/index.mjs",
    "postinstall": "nuxt prepare",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --tsconfig tsconfig.scripts.json scripts/migrate.ts",
    "db:seed": "tsx --tsconfig tsconfig.scripts.json scripts/seed.ts",
    "db:reset": "tsx --tsconfig tsconfig.scripts.json scripts/reset.ts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "vue-tsc -b --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "@iconify-json/lucide": "^1.2.149",
    "@nuxt/icon": "^2.6.2",
    "drizzle-orm": "^0.45.4",
    "file-type": "^22.3.0",
    "nuxt": "^4.6.3",
    "nuxt-auth-utils": "^0.5.34",
    "pdf-lib": "^1.17.1",
    "postgres": "^3.4.9",
    "unpdf": "^2.0.0",
    "vue": "^3.5.0",
    "vue-router": "^4.5.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@nuxt/eslint": "^1.17.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.20.5",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10.13.0",
    "h3": "^1.15.11",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.19.0",
    "typescript": "^5.9.0",
    "vitest": "^5.0.5",
    "vue-tsc": "^3.3.13"
  }
}
